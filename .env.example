# Salin ke .env lalu isi. JANGAN commit .env.

# API key Speko (https://speko.dev) — dipakai voice/speko_tts.py untuk sintesis VO.
# Wajib hanya untuk tahap voice-over; render bisa jalan tanpa ini bila VO sudah ada.
SPEKO_API_KEY=

# Suara & bahasa default VO (opsional)
SPEKO_VOICE=Puck
SPEKO_LANG=id

# Render hybrid (opsional): path ke helper CLI MCP Simular Box kamu
# (CLI yang mendukung: call-tool --name <tool> --arguments-file <json>).
BOX_MCP_HELPER=

# Identitas episode untuk skrip render (opsional; default = episode contoh)
COMP_ID=ExampleEpisode
TOTAL_FRAMES=1659
EPISODE_OUTPUT=episode-55s.mp4
